{
  "name": "syllune",
  "private": true,
  "version": "0.24.1",
  "productName": "Syllune",
  "description": "Local dictation and private meeting notes",
  "author": "Loathious",
  "license": "UNLICENSED",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.js",
    "dist:win": "electron-builder --win nsis --x64 --publish never"
  },
  "devDependencies": {
    "electron": "44.7.0",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "io.syllune.desktop",
    "productName": "Syllune",
    "executableName": "Syllune",
    "directories": {"output": "../dist/syllune", "buildResources": "assets"},
    "files": ["*.js", "*.html", "brand.json", "hub/**/*", "assets/syllune.*", "!tests/**"],
    "copyright": "Copyright (c) 2026 Loathious",
    "extraResources": [{"from": "../dist/SylluneEngine", "to": "engine", "filter": ["**/*"]},
      {"from": "../LICENSE", "to": "LICENSE.txt"}, {"from": "../THIRD_PARTY_NOTICES.md", "to": "THIRD_PARTY_NOTICES.md"}],
    "asar": true,
    "electronLanguages": ["en-US", "sv"],
    "win": {"target": "nsis", "icon": "assets/syllune.ico", "legalTrademarks": "Syllune", "requestedExecutionLevel": "asInvoker", "artifactName": "Syllune-Setup-${version}-${arch}.${ext}"},
    "nsis": {"oneClick": false, "perMachine": false, "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true, "createStartMenuShortcut": true, "shortcutName": "Syllune",
      "deleteAppDataOnUninstall": false, "runAfterFinish": true, "license": "../LICENSE",
      "installerIcon": "assets/syllune.ico", "uninstallerIcon": "assets/syllune.ico",
      "installerSidebar": "assets/installerSidebar.bmp", "uninstallerSidebar": "assets/uninstallerSidebar.bmp",
      "installerHeader": "assets/installerHeader.bmp", "uninstallDisplayName": "Syllune", "warningsAsErrors": false},
    "publish": null
  }
}
